-- ============================================================
-- SERIALIZE
-- ============================================================
local function ser(v, depth)
    depth = (depth or 0) + 1
    if depth > 6 then return { __t = "N" } end
    local t = typeof(v)
    if t == "CFrame" then return { __t = "CF", v = { v:GetComponents() } } end
    if t == "Vector3" then return { __t = "V3", v = { v.X, v.Y, v.Z } } end
    if t == "Vector2" then return { __t = "V2", v = { v.X, v.Y } } end
    if t == "Instance" then
        local path = {}
        local p = v
        while p and p ~= game do table.insert(path, 1, p.Name); p = p.Parent end
        return { __t = "I", v = path }
    end
    if t == "table" then
        if #v > 0 then
            local arr = {}
            for i, x in ipairs(v) do arr[i] = ser(x, depth) end
            return { __t = "A", v = arr }
        else
            local map = {}
            for k, x in pairs(v) do map[tostring(k)] = ser(x, depth) end
            return { __t = "T", v = map }
        end
    end
    if t == "nil" then return { __t = "N" } end
    return v
end

local function resolvePath(path)
    local cur = game
    for _, name in ipairs(path) do
        cur = cur and (cur:FindFirstChild(name) or (cur == game and game:GetService(name)))
    end
    return cur
end

local function deser(v, idMap)
    if type(v) ~= "table" then
        if type(v) == "string" and idMap and idMap[v] then return idMap[v] end
        return v
    end
    local t = v.__t
    if t == "CF" then return CFrame.new(unpack(v.v)) end
    if t == "V3" then return Vector3.new(unpack(v.v)) end
    if t == "V2" then return Vector2.new(unpack(v.v)) end
    if t == "I" then return resolvePath(v.v) end
    if t == "N" then return nil end
    if t == "A" then
        local arr = {}
        for i, x in ipairs(v.v) do arr[i] = deser(x, idMap) end
        return arr
    end
    if t == "T" then
        local map = {}
        for k, x in pairs(v.v) do map[k] = deser(x, idMap) end
        return map
    end
    if type(v) == "string" and idMap and idMap[v] then return idMap[v] end
    return v
end

local function packArgs(pk)
    local out = { n = pk.n }
    for i = 1, pk.n do out[i] = ser(pk[i]) end
    return out
end

local function unpackArgs(pk, idMap)
    local out = { n = pk.n }
    for i = 1, pk.n do out[i] = deser(pk.list[i], idMap) end
    return out
end

