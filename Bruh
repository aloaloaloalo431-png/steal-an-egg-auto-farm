        local lastVote = 0
        while true do
            if voteRemote and settings.autoVote then
                if os.clock() - lastVote >= 60 then
                    lastVote = os.clock()
                    pcall(function() voteRemote:FireServer(settings.voteMode or "Insane") end)
                end
            else
                lastVote = 0
            end
            task.wait(1)
        end
    end)

