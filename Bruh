    task.spawn(function()
        local speedRemote = RemoteFunction:WaitForChild("ChangeSpeed", 10)
        local lastSpeed = nil
        while true do
            if speedRemote and settings.speed then
                if lastSpeed ~= settings.speed then
                    lastSpeed = settings.speed
                    pcall(function() speedRemote:InvokeServer(settings.speed) end)
                end
            end
            task.wait(2)
        end
    end)

