    task.spawn(function()
        task.wait(10)
        local waveSkip = RemoteEvent:FindFirstChild("WaveSkip")
        local lastStop = nil

        local function getWave()
            pcall(function()
                local gui = Player:FindFirstChild("PlayerGui")
                local gameUI = gui and gui:FindFirstChild("GameUI")
                local stats = gameUI and gameUI:FindFirstChild("Stats")
                local wave = stats and stats:FindFirstChild("Wave")
                if wave then
                    return tonumber(tostring(wave.Text or wave.ContentText or ""):match("%d+"))
                end
            end)
            return nil
        end

        while true do
            pcall(function()
                if not settings.autoSkip then return end
                if not waveSkip then
                    waveSkip = RemoteEvent:FindFirstChild("WaveSkip")
                    return
                end
                local w = getWave()
                if w and settings.skipStop and settings.skipStop[tostring(w)] then
                    if lastStop ~= w then
                        lastStop = w
                        print("[Auto Skip] Dừng skip tại wave " .. w)
                    end
                    return
                end
                lastStop = nil
                waveSkip:FireServer()
            end)
            task.wait(1)
        end
    end)
end
