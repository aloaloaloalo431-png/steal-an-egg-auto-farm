local function getMoney()
    local ls = Player:FindFirstChild("leaderstats")
    if not ls then return 0 end
    local m = ls:FindFirstChild("Money") or ls:FindFirstChild("Coins") or ls:FindFirstChild("Cash")
    return m and m.Value or 0
end

local function waitMoney(need)
    if not need or need <= 0 then return true end
    local t = os.clock() + 30
    while os.clock() < t do
        if getMoney() >= need then return true end
        task.wait(0.2)
    end
    return false
end

local request_ = request or http_request or (syn and syn.request)

local function isValidWebhook(url)
    return type(url) == "string" and (
        url:find("^https://discord%.com/api/webhooks/%d+/[%w_%-]+") or
        url:find("^https://discordapp%.com/api/webhooks/%d+/[%w_%-]+") or
        url:find("^https://canary%.discord%.com/api/webhooks/%d+/[%w_%-]+") or
        url:find("^https://ptb%.discord%.com/api/webhooks/%d+/[%w_%-]+")
    ) ~= nil
end

local function sendWebhook(embed)
    if not request_ then return false, "Không có request" end
    if not isValidWebhook(settings.webhook.url) then return false, "URL không hợp lệ" end
    local ok, res = pcall(request_, {
        Url = settings.webhook.url, Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = HttpService:JSONEncode({ embeds = { embed } }),
    })
    if not ok then return false, tostring(res) end
    local code = res and (res.StatusCode or res.Status)
    if code == 200 or code == 204 then return true, code end
    return false, "Status " .. tostring(code)
end
