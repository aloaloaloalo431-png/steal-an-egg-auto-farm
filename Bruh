local function patchUnitId(tbl, newId)
    local function walk(t)
        if type(t) ~= "table" then return end
        if t.__t == "T" and type(t.v) == "table" and t.v.UnitId ~= nil then t.v.UnitId = newId end
        for _, x in pairs(t) do walk(x) end
    end
    walk(tbl)
end

