local function playMacro(name)
    local actions = readMacro(name)
    if not actions or #actions == 0 then
        Notify("❌ Macro", "Không đọc được macro", 3)
        return
    end

    local idMap = {}
    for _, a in ipairs(actions) do
        if a.type == "place" and a.call then
            local uid = a.unitId or findUnitId(a.call.args)
            if uid and uid ~= "-" then idMap[uid] = uid end
        end
    end

    Notify("🎯 Play", "Chạy " .. #actions .. " bước...", 3)

    for i, a in ipairs(actions) do
        if a.call then
            waitMoney(a.price)
            local remote = resolvePath(a.call.path)
            if remote then
                local args = unpackArgs(a.call.args, idMap)
                pcall(function()
                    if a.call.method == "InvokeServer" then
                        task.spawn(function() remote:InvokeServer(unpack(args, 1, args.n)) end)
                    else
                        remote:FireServer(unpack(args, 1, args.n))
                    end
                end)
            end
            task.wait(0.15)
        end
    end

    Notify("✅ Done", "Đã chạy " .. #actions .. " bước", 3)
end
