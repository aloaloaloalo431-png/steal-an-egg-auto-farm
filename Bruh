    local found
    local function walk(t)
        if type(t) ~= "table" or found then return end
        if t.__t == "T" and type(t.v) == "table" and type(t.v.UnitId) == "string" then found = t.v.UnitId end
        for _, x in pairs(t) do walk(x) end
    end
    walk(tbl)
    return found
end

local function unitsNeeded(actions)
    local seen, list = {}, {}
    for _, a in ipairs(actions) do
        if a.type == "place" and a.name and not seen[a.name] then
            seen[a.name] = true
            table.insert(list, a.name)
        end
    end
    return list
end

local function encodeShare(name, actions)
    local json = HttpService:JSONDecode(HttpService:JSONEncode(actions))
    local idMap, n = {}, 0
    for _, a in ipairs(json) do
        if type(a.id) == "string" and not idMap[a.id] then
            n = n + 1
            idMap[a.id] = "~" .. n
        end
    end
    for _, a in ipairs(json) do
        if a.type == "place" then
            a.unitId = nil
            if a.call then patchUnitId(a.call.args, "-") end
        end
        a.t = nil
        if type(a.id) == "string" then a.id = idMap[a.id] end
        if a.call then
            local function remap(t)
                if type(t) ~= "table" then return end
                for k, x in pairs(t) do
                    if type(x) == "string" and idMap[x] then t[k] = idMap[x]
                    elseif type(x) == "table" then remap(x) end
                end
            end
            remap(a.call.args)
        end
    end
    return "CTDV1:" .. cleanName(name) .. ":" .. HttpService:JSONEncode(json)
end

local function decodeShare(code)
    code = tostring(code or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local name, body
    if code:sub(1, 5) == "CTDV1:" then
        name, body = code:match("^CTDV1:([^:]*):(.+)$")
    elseif code:sub(1, 1) == "[" then
        name, body = "Imported", code
    end
    if not name then return nil, "Cần bắt đầu bằng CTDV1: hoặc [" end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok or type(data) ~= "table" or #data == 0 then return nil, "JSON hỏng" end
    if #data > 3000 then return nil, "Quá lớn (>3000 step)" end
    for i, a in ipairs(data) do
        if type(a) ~= "table" or not a.call or type(a.call.path) ~= "table" then
            return nil, "Step " .. i .. " sai"
        end
    end
    return name, data
end

