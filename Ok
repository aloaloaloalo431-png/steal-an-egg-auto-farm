-- Serialize
local function ser(v, depth)
    depth = (depth or 0) + 1
    if depth > 6 then return { __t = "N" } end
    local t = typeof(v)
    if t == "CFrame" then return { __t = "CF", v = { v:GetComponents() } } end
    if t == "Vector3" then return { __t = "V3", v = { v.X, v.Y, v.Z } } end
    if t == "Vector2" then return { __t = "V2", v = { v.X, v.Y } } end
    if t == "Instance" then
        local path = {}
        local p = v
        while p and p ~= game do table.insert(path, 1, p.Name); p = p.Parent end
        return { __t = "I", v = path }
    end
    if t == "table" then
        if #v > 0 then
            local arr = {}
            for i, x in ipairs(v) do arr[i] = ser(x, depth) end
            return { __t = "A", v = arr }
        else
            local map = {}
            for k, x in pairs(v) do map[tostring(k)] = ser(x, depth) end
            return { __t = "T", v = map }
        end
    end
    if t == "nil" then return { __t = "N" } end
    return v
end
local function resolvePath(path)
    local cur = game
    for _, name in ipairs(path) do
        cur = cur and (cur:FindFirstChild(name) or (cur == game and game:GetService(name)))
    end
    return cur
end
local function deser(v, idMap)
    if type(v) ~= "table" then
        if type(v) == "string" and idMap and idMap[v] then return idMap[v] end
        return v
    end
    local t = v.__t
    if t == "CF" then return CFrame.new(unpack(v.v)) end
    if t == "V3" then return Vector3.new(unpack(v.v)) end
    if t == "V2" then return Vector2.new(unpack(v.v)) end
    if t == "I" then return resolvePath(v.v) end
    if t == "N" then return nil end
    if t == "A" then
        local arr = {}
        for i, x in ipairs(v.v) do arr[i] = deser(x, idMap) end
        return arr
    end
    if t == "T" then
        local map = {}
        for k, x in pairs(v.v) do map[k] = deser(x, idMap) end
        return map
    end
    if type(v) == "string" and idMap and idMap[v] then return idMap[v] end
    return v
end
local function packArgs(pk)
    local out = { n = pk.n }
    for i = 1, pk.n do out[i] = ser(pk[i]) end
    return out
end
local function unpackArgs(pk, idMap)
    local out = { n = pk.n }
    for i = 1, pk.n do out[i] = deser(pk.list[i], idMap) end
    return out
end

-- Share code
local function patchUnitId(tbl, newId)
    local function walk(t)
        if type(t) ~= "table" then return end
        if t.__t == "T" and type(t.v) == "table" and t.v.UnitId ~= nil then t.v.UnitId = newId end
        for _, x in pairs(t) do walk(x) end
    end
    walk(tbl)
end
local function findUnitId(tbl)
    local found
    local function walk(t)
        if type(t) ~= "table" or found then return end
        if t.__t == "T" and type(t.v) == "table" and type(t.v.UnitId) == "string" then found = t.v.UnitId end
        for _, x in pairs(t) do walk(x) end
    end
    walk(tbl)
    return found
end
local function encodeShare(name, actions)
    local json = HttpService:JSONDecode(HttpService:JSONEncode(actions))
    local idMap, n = {}, 0
    for _, a in ipairs(json) do
        if type(a.id) == "string" and not idMap[a.id] then n = n + 1; idMap[a.id] = "~" .. n end
    end
    for _, a in ipairs(json) do
        if a.type == "place" then
            a.unitId = nil
            if a.call then patchUnitId(a.call.args, "-") end
        end
        a.t = nil
        if type(a.id) == "string" then a.id = idMap[a.id] end
        if a.call then
            local function remap(t)
                if type(t) ~= "table" then return end
                for k, x in pairs(t) do
                    if type(x) == "string" and idMap[x] then t[k] = idMap[x]
                    elseif type(x) == "table" then remap(x) end
                end
            end
            remap(a.call.args)
        end
    end
    return "CTDV1:" .. cleanName(name) .. ":" .. HttpService:JSONEncode(json)
end
local function decodeShare(code)
    code = tostring(code or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local name, body
    if code:sub(1, 5) == "CTDV1:" then
        name, body = code:match("^CTDV1:([^:]*):(.+)$")
    elseif code:sub(1, 1) == "[" then
        name, body = "Imported", code
    end
    if not name then return nil, "Cần bắt đầu bằng CTDV1: hoặc [" end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok or type(data) ~= "table" or #data == 0 then return nil, "JSON hỏng" end
    if #data > 3000 then return nil, "Quá lớn (>3000 step)" end
    for i, a in ipairs(data) do
        if type(a) ~= "table" or not a.call or type(a.call.path) ~= "table" then
            return nil, "Step " .. i .. " sai"
        end
    end
    return name, data
end

