local ChoDien_Library, Notification = {}, {}

function ChoDien_Library:SetNotification(Config)
    local Title = Config[1] or Config.Title or "🐶 Chó Điên"
    local Description = Config[2] or Config.Description or ""
    local Content = Config[3] or Config.Content or ""
    local Time = Config[5] or Config.Time or 0.4
    local Delay = Config[6] or Config.Delay or 5

    local Gui = Custom:Create("ScreenGui", { ZIndexBehavior = Enum.ZIndexBehavior.Sibling },
        gethui and gethui() or game:GetService("CoreGui"))
    local Layout = Custom:Create("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        BackgroundTransparency = 0.999,
        Position = UDim2.new(1, -30, 1, -30),
        Size = UDim2.new(0, 320, 1, 0),
        Parent = Gui,
    })
    local Count = 0
    Layout.ChildRemoved:Connect(function()
        Count = 0
        for _, v in ipairs(Layout:GetChildren()) do
            TweenService:Create(v, TweenInfo.new(0.3), { Position = UDim2.new(0, 0, 1, -((v.Size.Y.Offset + 12) * Count)) }):Play()
            Count = Count + 1
        end
    end)
    local _Count = 0
    for _, v in ipairs(Layout:GetChildren()) do
        _Count = -(v.Position.Y.Offset) + v.Size.Y.Offset + 12
    end

    local Frame = Custom:Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 150),
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, -_Count),
        Parent = Layout,
    })
    local Real = Custom:Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(15, 15, 15),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 400, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        Parent = Frame,
    })
    Custom:Create("UICorner", { CornerRadius = UDim.new(0, 8) }, Real)
    Custom:Create("UIStroke", { Color = Custom.ColorRGB, Thickness = 1.2 }, Real)

    local Top = Custom:Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 36),
        Parent = Real,
    })
    Custom:Create("TextLabel", {
        Font = Enum.Font.GothamBold, Text = Title, TextColor3 = Color3.new(1, 1, 1),
        TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.fromOffset(10, 0), Parent = Top,
    })
    local Close = Custom:Create("TextButton", {
        Font = Enum.Font.SourceSans, Text = "X", TextColor3 = Color3.new(1, 1, 1),
        TextSize = 18, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -5, 0.5, 0), Size = UDim2.new(0, 25, 0, 25),
        BackgroundTransparency = 1, Parent = Top,
    })
    local Body = Custom:Create("TextLabel", {
        Font = Enum.Font.GothamBold, Text = Content, TextColor3 = Color3.fromRGB(180, 180, 180),
        TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 27), Size = UDim2.new(1, -20, 0, 13),
        Parent = Real,
    })
    Body.Size = UDim2.new(1, -20, 0, 13 + (13 * (Body.TextBounds.X // Body.AbsoluteSize.X)))
    Frame.Size = UDim2.new(1, 0, 0, Body.AbsoluteSize.Y + 40)

    local Waitted = false
    function Notification:Close()
        if Waitted then return end
        Waitted = true
        TweenService:Create(Real, TweenInfo.new(Time, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), { Position = UDim2.new(0, 400, 0, 0) }):Play()
        task.wait(Time / 1.2)
        Frame:Destroy()
        Waitted = false
    end
    Close.Activated:Connect(function() Notification:Close() end)
    TweenService:Create(Real, TweenInfo.new(Time, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), { Position = UDim2.new(0, 0, 0, 0) }):Play()
    task.wait(Delay)
    Notification:Close()
    return Notification
end

