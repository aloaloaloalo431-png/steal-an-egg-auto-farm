local methodMap = {}
if towerAdd then methodMap[towerAdd] = "place" end
if towerUpgrade then methodMap[towerUpgrade] = "upgrade" end
if towerSell then methodMap[towerSell] = "sell" end
if towerTarget then methodMap[towerTarget] = "target" end

local recording = false
local recorded = {}
local pending = {}
local towerIds = {}

local function stopRecord()
    recording = false
end

local function startRecord()
    recorded = {}
    pending = {}
    recording = true
    ChoDien_Library:SetNotification({ "🎯 Ghi Macro", "", "Bắt đầu ghi thao tác...", Delay = 3 })
end

local function pushAction(a)
    a.t = os.clock()
    table.insert(recorded, a)
end

if hookmetamethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local kind = methodMap[self]
        if recording and kind and (method == "FireServer" or method == "InvokeServer") then
            local args = table.pack(...)
            task.defer(function()
                pcall(function()
                    local first = args[1]
                    if type(first) ~= "table" then return end
                    local path = {}
                    local obj = self
                    while obj and obj ~= game do table.insert(path, 1, obj.Name); obj = obj.Parent end
                    local act = {
                        kind = kind, t = os.clock(),
                        call = { path = path, method = method, args = packArgs(args) },
                    }
                    if kind == "place" then
                        act.name = first.Name
                        act.unitId = first.UnitId
                        act.pos = first.Pos or (typeof(first.CFrame) == "CFrame" and first.CFrame.Position or nil)
                    else
                        act.id = first.Id
                        act.mode = first.TargetMode or first.Mode
                    end
                    table.insert(pending, act)
                    if #pending > 80 then table.remove(pending, 1) end
                end)
            end)
        end
        return oldNamecall(self, ...)
    end)
end

if towerAdd then
    towerAdd.OnClientEvent:Connect(function(info)
        if type(info) ~= "table" or info.OwnerUserId ~= Player.UserId then return end
        if towerIds[info.Id] then return end
        towerIds[info.Id] = true
        if not recording then return end
        local pos = info.Pos or info.HomePos
        local matchAct
        for i, a in ipairs(pending) do
            if a.kind == "place" and pos and a.pos and (a.pos - pos).Magnitude < 3 then
                matchAct = a; table.remove(pending, i); break
            end
        end
        if not matchAct then
            for i, a in ipairs(pending) do
                if a.kind == "place" and a.name == info.Name then
                    matchAct = a; table.remove(pending, i); break
                end
            end
        end
        if matchAct then
            pushAction({
                type = "place", id = info.Id, name = info.Name,
                unitId = matchAct.unitId or info.UnitId,
                price = info.Stats and info.Stats.Price or 0,
                call = matchAct.call,
            })
        end
    end)
end
if towerUpgrade then
    towerUpgrade.OnClientEvent:Connect(function(info)
        if type(info) ~= "table" then return end
        if not recording or not towerIds[info.Id] then return end
        for i, a in ipairs(pending) do
            if a.kind == "upgrade" and a.id == info.Id then
                table.remove(pending, i)
                pushAction({ type = "upgrade", id = info.Id, level = info.Level, price = info.Stats and info.Stats.Price or 0, call = a.call })
                break
            end
        end
    end)
end
if towerRemove then
    towerRemove.OnClientEvent:Connect(function(info)
        if type(info) ~= "table" or not info.Id then return end
        if not recording or not towerIds[info.Id] then return end
        for i, a in ipairs(pending) do
            if a.kind == "sell" and a.id == info.Id then
                table.remove(pending, i)
                pushAction({ type = "sell", id = info.Id, call = a.call })
                break
            end
        end
    end)
end
if towerTarget then
    towerTarget.OnClientEvent:Connect(function(info)
        if type(info) ~= "table" or not info.Id then return end
        if not recording or not towerIds[info.Id] then return end
        for i, a in ipairs(pending) do
            if a.kind == "target" and a.id == info.Id then
                table.remove(pending, i)
                pushAction({ type = "target", id = info.Id, mode = info.TargetMode, call = a.call })
                break
            end
        end
    end)
end

local function getMoney()
    local ls = Player:FindFirstChild("leaderstats")
    local m = ls and ls:FindFirstChild("Money")
    return m and m.Value or 0
end

local function waitMoney(need)
    if not need or need <= 0 then return true end
    local t = os.clock() + 30
    while os.clock() < t do
        if getMoney() >= need then return true end
        task.wait(0.2)
    end
    return false
end

local function playMacro(name)
    local actions = readMacro(name)
    if not actions or #actions == 0 then
        ChoDien_Library:SetNotification({ "❌ Macro", "", "Không đọc được macro", Delay = 3 })
        return
    end
    local idMap = {}
    for _, a in ipairs(actions) do
        if a.type == "place" and a.call then
            local uid = a.unitId or findUnitId(a.call.args)
            if uid and uid ~= "-" then idMap[uid] = uid end
        end
    end
    ChoDien_Library:SetNotification({ "🎯 Play", "", "Chạy " .. #actions .. " bước...", Delay = 3 })
    for i, a in ipairs(actions) do
        if a.call then
            waitMoney(a.price)
            local remote = resolvePath(a.call.path)
            if remote then
                local args = unpackArgs(a.call.args, idMap)
                pcall(function()
                    if a.call.method == "InvokeServer" then
                        task.spawn(function() remote:InvokeServer(unpack(args, 1, args.n)) end)
                    else
                        remote:FireServer(unpack(args, 1, args.n))
                    end
                end)
            end
            task.wait(0.15)
        end
    end
    ChoDien_Library:SetNotification({ "✅ Done", "", "Đã chạy " .. #actions .. " bước", Delay = 3 })
end
